CORS_ORIGIN=https://spap-frontend-production.up.railway.app
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Cloudflare Turnstile server-side verification
TURNSTILE_SECRET_KEY=

# SMTP email notifications
EMAIL_NOTIFY_ENABLED=true
EMAIL_TRANSPORT=resend
EMAIL_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=tls
EMAIL_FROM=
EMAIL_FROM_NAME=SPAP App
EMAIL_REPLY_TO=

# Email OTP for admin login. Enable only after email delivery is verified.
ADMIN_OTP_ENABLED=false
ADMIN_OTP_EMAIL=beliberkah21@gmail.com

# Admin login identity
SPAP_ADMIN_EMAIL=beliberkah21@gmail.com
